{
  "name": "matterbridge-wiz-lan-platform",
  "description": "Matterbridge plugin for Wiz over LAN",
  "version": "2.1.1",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "matterbridge-wiz-lan-platform.schema.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run cleanBuild",
    "pack:plugin": "npm run cleanBuild && node scripts/pack-plugin.mjs",
    "lint": "eslint src/**.ts",
    "lint:fix": "eslint src/**.ts --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "clean": "node -e \"const fs=require('fs').promises;Promise.all(['tsconfig.tsbuildinfo','dist'].map(p=>fs.rm(p,{recursive:true,force:true}))).catch(console.error)\"",
    "cleanBuild": "npm run clean && tsc",
    "deepClean": "rimraf tsconfig.tsbuildinfo package-lock.json ./dist ./node_modules",
    "prepublishOnly": "npm run lint && npm run cleanBuild"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@stylistic/eslint-plugin": "^2.12.1",
    "@tsconfig/node-lts": "^18.12.5",
    "@types/node": "^18.19.34",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "matterbridge": "3.11.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.13.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "author": "AMoo-Miki Inc.",
  "license": "Apache-2.0",
  "repository": {
    "url": "https://github.com/shgeum/matterbridge-wiz-lan-platform"
  }
}
